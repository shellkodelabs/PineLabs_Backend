# Copy this file to .env for local development and fill in real values.
# Never commit a real .env file (it is already listed in .gitignore).

ENVIRONMENT=development

# SQLAlchemy connection string (postgresql+psycopg2://user:password@host:port/dbname)
DATABASE_URL=postgresql+psycopg2://pinelab_user:changeme@localhost:5432/pinelab_db

# Comma-separated list of frontend origins allowed to call this API.
# The PineLab frontend runs on Vite's default dev port (see PineLabs_Frontend/vite.config.js).
CORS_ORIGINS=http://localhost:5173

API_V1_PREFIX=/api/v1

# --- Authentication (Part 14) ------------------------------------------
# Provider-neutral placeholders only. The real Pine Labs SSO/OIDC
# provider (issuer URL, audience/client id, JWKS endpoint) is not yet
# confirmed — see app/core/auth.py. Leave both unset for now: every
# request is rejected with a structured 401 regardless, by design, until
# a real provider is implemented and these are filled in with real
# values (never commit those real values here or anywhere in this repo).
AUTH_ISSUER=
AUTH_AUDIENCE=
